{
  "manifest_version": 3,
  "name": "Saved Tab Groups",
  "version": "0.1.0",
  "description": "Save, close, search, and restore Firefox tab groups from a toolbar popup or sidebar.",
  "author": "daniele-f",
  "homepage_url": "https://github.com/daniele-f/saved-tabs-extension",
  "browser_specific_settings": {
    "gecko_android": { "strict_min_version": "142.0" },
    "gecko": {
      "id": "saved-tab-groups-ux-playground@daniele-f",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["storage", "tabGroups", "tabs"],
  "icons": { "16": "icons/saved-groups.svg", "32": "icons/saved-groups.svg", "48": "icons/saved-groups.svg" },
  "action": {
    "default_title": "Saved Tab Groups",
    "default_icon": "icons/saved-groups.svg",
    "default_popup": "popup/popup.html",
    "default_area": "personaltoolbar"
  },
  "sidebar_action": {
    "default_title": "Saved Tab Groups",
    "default_icon": "icons/saved-groups.svg",
    "default_panel": "sidebar/sidebar.html"
  }
}
