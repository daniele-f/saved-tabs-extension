{
  "manifest_version": 3,
  "name": "Saved Tab Groups",
  "version": "0.1.0",
  "description": "Read-only current-window Firefox tab groups in a popup and sidebar.",
  "browser_specific_settings": {
    "gecko": { "id": "saved-tab-groups-ux-playground@daniele-f" }
  },
  "permissions": ["storage", "tabGroups", "tabs"],
  "icons": { "16": "icons/saved-groups.svg", "32": "icons/saved-groups.svg", "48": "icons/saved-groups.svg" },
  "action": {
    "default_title": "Saved Tab Groups",
    "default_icon": "icons/saved-groups.svg",
    "default_popup": "popup/popup.html",
    "default_area": "personaltoolbar"
  },
  "sidebar_action": {
    "default_title": "Saved tab groups",
    "default_icon": "icons/saved-groups.svg",
    "default_panel": "sidebar/sidebar.html"
  }
}
